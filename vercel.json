{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "admin.html",
      "use": "@vercel/static"
    },
    {
      "src": "product-list.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/style.css",
      "dest": "/style.css",
      "headers": { "content-type": "text/css" }
    },
    {
      "src": "/app.js",
      "dest": "/app.js",
      "headers": { "content-type": "application/javascript" }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
